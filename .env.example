# LLM
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
OPENAI_API_KEY=
LLM_MAX_RETRIES=3

# Embeddings
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# Qdrant — use QDRANT_PATH for local file mode, or QDRANT_URL for Docker/Cloud
QDRANT_PATH=data/vector_store
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=smartdesk_kb
SPARSE_MODEL=Qdrant/bm25

# Retrieval
CONFIDENCE_THRESHOLD=0.30

# Semantic cache – reuse answers for similar IT/HR questions (memory/semantic_cache.py)
SEMANTIC_CACHE_ENABLED=true
CACHE_THRESHOLD=0.93
CACHE_TTL_HOURS=168

# Jira
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
JIRA_IT_PROJECT_KEY=IT
JIRA_HR_PROJECT_KEY=HR
USE_MOCK_TICKETING=false
JIRA_ISSUE_TYPE=Task
TICKET_DB_PATH=data/tickets/tickets.db
